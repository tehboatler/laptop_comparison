# ─── Free-first catalog (recommended) ───
# 1) npm run catalog:add -- --url "https://www.amazon.co.uk/dp/B0..." --gbp 999 --title "..."
# 2) npm run catalog:sonar
# 3) npm run catalog:sync

# Perplexity Sonar — flesh out TGP / battery / scores / notes
# https://www.perplexity.ai/api-platform
PERPLEXITY_API_KEY=
# sonar | sonar-pro | sonar-reasoning-pro
SONAR_MODEL=sonar
# Pacing (avoid 429) — not a “only 3 rows” product limit
SONAR_DELAY_MS=4000
# 0 / all = process entire matching queue in one command
SONAR_MAX=0
SONAR_RETRY_MAX=5
SONAR_RETRY_BASE_MS=20000
# Stop after this many consecutive failures (progress already saved)
# SONAR_FAIL_STOP=5


# ─── Optional: metoda Price API (OFF unless you opt in) ───
# Burns paid credits after free trial — not needed for the free workflow.
# CATALOG_PRICEAPI=1
# CATALOG_RESOLVE=1
# PRICEAPI_TOKEN=
# PRICEAPI_SOURCE=amazon
# PRICEAPI_COUNTRY=gb
# PRICEAPI_MAX=15

# ─── Optional: Amazon PA-API ───
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=
