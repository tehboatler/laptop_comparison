# ─── Recommended: metoda Price API (priceapi.com) ───
# Multi-shop prices from Amazon, Google Shopping, Idealo, Geizhals, etc.
# Signup (trial credits): https://www.priceapi.com/users/sign_up
# Docs/support: https://support.metoda.com
#
PRICEAPI_TOKEN=
# Sources depend on country — common: google_shopping | amazon | idealo | geizhals
PRICEAPI_SOURCE=google_shopping
# gb = United Kingdom, de = Germany
PRICEAPI_COUNTRY=gb
# Cap how many products to refresh per sync (credits!)
PRICEAPI_MAX=15
# Max age of cached data in seconds (0 = realtime, costs more)
# PRICEAPI_MAX_AGE=3600

# ─── Optional: Amazon Product Advertising API 5.0 ───
# Harder to get (Associates + approval). Best for exact ASIN rows only.
# https://webservices.amazon.com/paapi5/documentation/
#
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=
# AMAZON_HOST=webservices.amazon.co.uk
# AMAZON_REGION=eu-west-1
# AMAZON_MARKET=uk
