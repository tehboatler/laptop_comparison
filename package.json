{
  "name": "laptop-comparison",
  "private": true,
  "version": "1.6.0",
  "description": "Budget laptop finder — static app + catalog ops",
  "scripts": {
    "catalog:add": "node tools/from_listing.js",
    "catalog:import": "node tools/import_inbox.js",
    "catalog:sonar": "node tools/sonar_enrich.js",
    "catalog:sonar:unenriched": "node tools/sonar_enrich.js --status unenriched --max all",
    "catalog:sonar:ids": "node tools/sonar_enrich.js --status noids --max all",
    "catalog:sonar:discover": "node tools/sonar_discover.js",
    "catalog:sonar:discover:dry": "node tools/sonar_discover.js --dry-run",
    "catalog:sync": "node tools/sync_catalog.js",
    "catalog:resolve": "node tools/resolve_identifiers.js",
    "catalog:discover": "node tools/discover_laptops.js",
    "catalog:discover:apply": "node tools/discover_laptops.js --apply",
    "catalog:validate": "node tools/validate_catalog.js",
    "catalog:chassis": "node tools/normalize_chassis.js",
    "catalog:buys": "node tools/refresh_buy_links.js",
    "catalog:embed": "node tools/embed_data.js"
  },
  "engines": {
    "node": ">=18"
  }
}
